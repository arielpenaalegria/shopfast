# Copia este archivo a .env y rellénalo. NUNCA lo subas a GitHub.
PORT=3000
# Cadena larga y aleatoria (mínimo 32 caracteres) para firmar sesiones
SESSION_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
# true si la web va con HTTPS (recomendado en producción)
COOKIE_SECURE=false

# "mock" = simula al proveedor (para probar). "real" = usa la API de Central One
PROVIDER_MODE=mock
PROVIDER_BASE_URL=https://portal.centraloneglobal.com
PROVIDER_API_KEY=

# (opcional) cada cuántos ms se consulta el estado de los pedidos en proceso
# POLL_MS=15000

# (opcional) secreto de webhooks de Central One (Integración → Webhooks). Si lo pones, el panel recibe avisos
# firmados en  https://TU-DOMINIO/webhooks/central-one  (necesita HTTPS público). Sin esto se usa solo consulta periódica.
# WEBHOOK_SECRET=

# --- Base de datos (MongoDB Atlas) ---
MONGODB_URI=mongodb+srv://USUARIO:CLAVE@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=panel
# Solo para probar en local sin Mongo (se pierde al apagar): MEMORY_DB=1 y deja MONGODB_URI vacío

# --- Solo para hosting (Render) ---
# TRUST_PROXY=true                  # detrás del proxy de Render (IP real para el límite de intentos de login)
# ADMIN_USERNAME=  ADMIN_PASSWORD=  # crea el primer admin al arrancar (10+ caracteres); bórralos después de entrar

# --- Avisos por Telegram (opcional) ---
# Crea un bot con @BotFather y pega aquí su token. Luego cada usuario pulsa "Conectar Telegram" en el panel.
# TELEGRAM_BOT_TOKEN=

# --- Depósitos USDT BEP20 (opcional) ---
# Tu dirección BEP20 que recibe los pagos (solo la pública, NUNCA la clave privada ni la frase semilla)
# USDT_WALLET=0x...
# URL RPC de NodeReal para BSC mainnet: verifica los pagos por hash automáticamente
# BSC_RPC_URL=https://bsc-mainnet.nodereal.io/v1/TU_API_KEY
# BSC_MIN_CONFIRMATIONS=15
